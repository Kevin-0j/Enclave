# Copy to .env and run ./scripts/gen-secrets.sh to replace every CHANGE_ME with a random value.
# Never commit .env.

ENVIRONMENT=development
APP_ORIGIN=https://enclave.localhost
# Extra allowed origins for the Vite dev server (comma separated).
DEV_ORIGINS=http://localhost:5173

# Postgres roles (ADR 0001). Superuser is used only by the image's first-boot script.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
ENCLAVE_OWNER_PASSWORD=CHANGE_ME
ENCLAVE_APP_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

# Signing keys: access tokens, stream tokens (separate on purpose), refresh-token hashing pepper.
JWT_SECRET=CHANGE_ME
STREAM_TOKEN_SECRET=CHANGE_ME
REFRESH_PEPPER=CHANGE_ME
# Key-encryption key for camera URLs/credentials: 32 random bytes, base64 (envelope encryption).
CAMERA_KEK_B64=CHANGE_ME

# Media server credentials
SIM_PUBLISH_USER=sim
SIM_PUBLISH_PASS=CHANGE_ME
MEDIA_INTERNAL_USER=enclave-api
MEDIA_INTERNAL_PASS=CHANGE_ME
# Host browsers use for WebRTC ICE (LAN IP for phones on the same Wi-Fi).
WEBRTC_PUBLIC_HOST=127.0.0.1

# Seed: demo password for every seeded user (dev only).
SEED_PASSWORD=CHANGE_ME

# Limits
LOGIN_RATE_PER_MINUTE=10
STREAM_RATE_PER_MINUTE=120
